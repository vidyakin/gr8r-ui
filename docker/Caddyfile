# HTTPS для прод-развёртывания (docker-compose.prod.yml): сертификат Let's Encrypt для {$DOMAIN}.
# DOMAIN=localhost — локальная проверка с внутренним CA Caddy.
# Caddy не доверяет входящему X-Forwarded-For и ставит его сам: rate-limit входа видит настоящий IP клиента.
{$DOMAIN} {
	encode gzip
	reverse_proxy web:80
}

# Панель Umami (аналитика, docs/architecture/analytics.md): отдельный поддомен, нужна A-запись. UMAMI_DOMAIN задаёт compose
# (по умолчанию stats.$DOMAIN). Трекер на приложение приходит через nginx по /stats/ того же origin, не через этот адрес.
{$UMAMI_DOMAIN} {
	encode gzip
	reverse_proxy umami:3000
}
