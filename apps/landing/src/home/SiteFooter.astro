---
/* Подвал главной и страниц модулей */
import { DEFAULT_LOCALE, useI18n, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const { t } = useI18n(locale);
---

<footer class="h-footer">
  <div class="h-wrap h-footer-in">
    <span>{t('footer.rights', { year: new Date().getFullYear() })}</span>
    <span class="h-footer-r"><a href="/docs/">{t('footer.docs')}</a><a href="/privacy/">{t('footer.privacy')}</a><span>{t('footer.langs')}</span></span>
  </div>
</footer>
