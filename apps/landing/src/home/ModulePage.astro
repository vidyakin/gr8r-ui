---
/* Локализованная страница модуля: /[locale]/modules/<id>/ */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { ArrowRight, ArrowLeft, Plus, ImageIcon, Maximize2, X } from 'lucide-react';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ModuleRecording from './ModuleRecording';
import LeadFormIsland from './LeadFormIsland';
import ChatWidget from './ChatWidget';
import { MODULE_IDS, SCENES, type ModuleId } from '../demo/registry';
import { DEFAULT_LOCALE, useI18n, type Dict, type Locale, type TKey } from '../i18n';
import { getRuArticles, resolveModuleId } from '../blog';
import '../demo/frame.css';
import './home.css';
import './modules.css';

interface Props {
  id: ModuleId;
  locale?: Locale;
}
const { id, locale = DEFAULT_LOCALE } = Astro.props;
const { t, dict, path, modulePage } = useI18n(locale);
const APP_URL = import.meta.env.VITE_APP_URL ?? '/app/';
const mt = (m: ModuleId, k: 'name' | 'title' | 'text') => t(`alternative.modules.${m}.${k}` as TKey);
const page = modulePage(id);
const name = mt(id, 'name');
const altPath = `/modules/${id}/`;

const has = (file: string) => existsSync(join(process.cwd(), 'public', 'modules', id, file));
const scene = SCENES[id];
const heroShot = !scene && has('hero.jpg') ? `/modules/${id}/hero.jpg` : null;
const caption =
  id in dict.modules && 'caption' in dict.modules[id as keyof Dict['modules']]
    ? (dict.modules[id as keyof Dict['modules']] as { caption: string }).caption
    : '';
const features = page.features.map((f, i) => ({ ...f, src: has(`${i + 1}.jpg`) ? `/modules/${id}/${i + 1}.jpg` : null }));
const chain = page.chain as readonly (readonly [ModuleId, string])[];
const others = MODULE_IDS.filter(m => m !== id);
const relatedArticles =
  locale === 'ru'
    ? getRuArticles()
        .filter(a => a.frontmatter.modules?.some(m => resolveModuleId(m) === id))
        .slice(0, 3)
    : [];

const MODULE_SEO_TITLES: Record<Locale, Record<ModuleId, string>> = {
  ru: {
    tasks: 'Задачи и проекты для команды — FutureERP',
    crm: 'CRM для B2B и производства — FutureERP',
    docs: 'Документы и база знаний компании — FutureERP',
    services: 'Учёт услуг, записей и заказ-нарядов — FutureERP',
    production: 'Управление производством и себестоимостью — FutureERP',
    sales: 'Складской учёт, закупки и продажи — FutureERP',
    logistics: 'Логистика, автопарк и путевые листы — FutureERP',
    automations: 'Автоматизация бизнес-процессов — FutureERP',
    payroll: 'Расчёт зарплаты, смен и сдельщины — FutureERP',
  },
  en: {
    tasks: 'Tasks & Project Management — FutureERP',
    crm: 'B2B CRM & Sales Pipeline — FutureERP',
    docs: 'Team Docs & Knowledge Base — FutureERP',
    services: 'Service Orders & Scheduling — FutureERP',
    production: 'Manufacturing & Costing ERP — FutureERP',
    sales: 'Inventory, Purchasing & Sales — FutureERP',
    logistics: 'Fleet, Dispatch & Logistics — FutureERP',
    automations: 'Workflow Automations — FutureERP',
    payroll: 'Payroll, Shifts & Piecework — FutureERP',
  },
  es: {
    tasks: 'Gestión de tareas y proyectos — FutureERP',
    crm: 'CRM B2B y embudo de ventas — FutureERP',
    docs: 'Documentos y base de conocimiento — FutureERP',
    services: 'Órdenes de servicio y citas — FutureERP',
    production: 'Gestión de producción y costos — FutureERP',
    sales: 'Inventario, compras y ventas — FutureERP',
    logistics: 'Flota, envíos y logística — FutureERP',
    automations: 'Automatización de procesos — FutureERP',
    payroll: 'Nómina, turnos y destajo — FutureERP',
  },
};
const seoTitle = MODULE_SEO_TITLES[locale]?.[id] ?? `${name} — FutureERP`;
const ogImage = has('1.jpg') ? `/modules/${id}/1.jpg` : '/alternative/crm-dashboard.png';
const site = Astro.site ?? new URL('https://future-erp.ru');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FutureERP', item: new URL(path('/'), site).href },
      { '@type': 'ListItem', position: 2, name, item: new URL(path(altPath), site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faq.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];
---

<Base title={seoTitle} description={mt(id, 'text')} theme="light" locale={locale} altPath={altPath} ogImage={ogImage} jsonLd={jsonLd}>
  <div class="h-page">
    <SiteHeader base="/" locale={locale} altPath={altPath} />

    <main id="main">
      <section class="h-hero h-mp-hero" aria-labelledby="h-mp-title">
        <div class="h-wrap">
          <a class="h-mp-back" href={`${path('/')}#modules`}><ArrowLeft size={16} aria-hidden="true" />{t('modulePages.ui.all')}</a>
          <div class:list={['h-mp-hero-in', !scene && !heroShot && 'h-mp-hero-solo']}>
            <div class="h-mp-hero-text">
              <p class="h-pill"><span class="h-dot"></span>{t('modulePages.ui.moduleLabel')} · {name}</p>
              <h1 id="h-mp-title">{mt(id, 'title')}</h1>
              <p class="h-lead">{mt(id, 'text')}</p>
              <div class="h-cta">
                <a class="h-btn" href={APP_URL}>{t('modulePages.ui.demo')}<ArrowRight size={16} aria-hidden="true" /></a>
                <a class="h-btn h-btn-2" href="#request">{t('modulePages.ui.request')}</a>
              </div>
            </div>
            {scene && (
              <div class="h-mp-hero-rec">
                <ModuleRecording client:visible id={id} label={t('modulePages.ui.recLabel', { name })} caption={caption} locale={locale} />
              </div>
            )}
            {heroShot && (
              <div class="h-mp-hero-rec">
                <img src={heroShot} alt={t('modulePages.ui.recLabel', { name })} width="1280" height="800" />
              </div>
            )}
          </div>
        </div>
      </section>

      <div class="h-mp-feats">
        {features.map((f, i) => (
          <section class="h-mp-feat" aria-labelledby={`h-mp-f${i}`}>
            <div class="h-wrap h-mp-feat-in">
              <div class="h-mp-feat-text">
                <h2 id={`h-mp-f${i}`}>{f.title}</h2>
                <p>{f.text}</p>
                <ul>
                  {f.list.map(item => <li>{item}</li>)}
                </ul>
              </div>
              <figure class="h-mp-shot">
                {f.src ? (
                  <button type="button" class="h-mp-zoom" data-zoom={f.src} data-alt={f.screen} aria-label={`${t('modulePages.ui.zoomOpen')}: ${f.screen}`}>
                    <img src={f.src} alt={f.screen} loading="lazy" width="1280" height="800" />
                    <span class="h-mp-zoom-hint" aria-hidden="true"><Maximize2 size={14} />{t('modulePages.ui.zoomOpen')}</span>
                  </button>
                ) : (
                  <div class="h-mp-ph" role="img" aria-label={f.screen}>
                    <ImageIcon size={28} aria-hidden="true" />
                    <strong>{f.screen}</strong>
                    <span>{t('modulePages.ui.shotSoon')}</span>
                  </div>
                )}
              </figure>
            </div>
          </section>
        ))}
      </div>

      <section class="h-how h-mp-chain" aria-labelledby="h-mp-chain-title">
        <div class="h-wrap">
          <h2 id="h-mp-chain-title">{t('modulePages.ui.chainTitle')}</h2>
          <p class="h-mp-chain-lead">{t('modulePages.ui.chainLead')}</p>
          <ol class="h-mp-steps">
            {chain.map(([m, passes], i) => (
              <li class:list={['h-mp-step', m === id && 'h-mp-step-cur']} aria-current={m === id ? 'step' : undefined}>
                <span class="h-mp-step-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>
                  {m === id ? <span>{mt(m, 'name')}</span> : <a href={path(`/modules/${m}/`)}>{mt(m, 'name')}</a>}
                </h3>
                {m === id && <span class="h-mp-cur-tag">{t('modulePages.ui.chainCurrent')}</span>}
                <p class="h-mp-pass-label">{i === chain.length - 1 ? t('modulePages.ui.chainResult') : t('modulePages.ui.chainPasses')}</p>
                <p class="h-mp-pass">{passes}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="h-faq" aria-labelledby="h-mp-faq-title">
        <div class="h-wrap h-faq-in">
          <h2 id="h-mp-faq-title">{t('modulePages.ui.faqTitle')}</h2>
          <div class="h-faq-list">
            {page.faq.map(([q, a]) => (
              <details>
                <summary><span>{q}</span><Plus size={20} class="h-plus" aria-hidden="true" /></summary>
                <p>{a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="h-final-sec" id="request" aria-labelledby="h-final-title">
        <div class="h-wrap">
          <div class="h-final">
            <div class="h-final-text">
              <h2 id="h-final-title">{t('modulePages.ui.finalTitle', { name })}</h2>
              <p>{t('modulePages.ui.finalLead')}</p>
              <a class="h-btn h-btn-white" href={APP_URL}>{t('modulePages.ui.demo')}<ArrowRight size={16} aria-hidden="true" /></a>
            </div>
            <div class="h-final-form">
              <h3>{t('form.title')}</h3>
              <LeadFormIsland client:visible locale={locale} />
            </div>
          </div>
          {relatedArticles.length > 0 && (
            <section class="h-mp-articles" aria-labelledby="h-mp-articles-title">
              <h2 id="h-mp-articles-title">Статьи по теме</h2>
              <div class="h-mp-articles-grid">
                {relatedArticles.map(({ frontmatter: a }) => (
                  <a class="h-mp-article-card" href={`/blog/${a.slug}/`}>
                    <span>{a.industry}</span>
                    <h3>{a.title}</h3>
                  </a>
                ))}
              </div>
            </section>
          )}
          <nav class="h-mp-others" aria-labelledby="h-mp-others-title">
            <h2 id="h-mp-others-title">{t('modulePages.ui.otherTitle')}</h2>
            <ul>
              {others.map(m => <li><a href={path(`/modules/${m}/`)}>{mt(m, 'name')}</a></li>)}
            </ul>
          </nav>
        </div>
      </section>
    </main>

    <SiteFooter locale={locale} />
  </div>
  <ChatWidget client:idle locale={locale} />

  <dialog class="h-zoom" aria-label={t('modulePages.ui.zoomOpen')}>
    <figure class="h-zoom-fig">
      <img class="h-zoom-img" alt="" width="1280" height="800" />
      <figcaption class="h-zoom-cap"></figcaption>
    </figure>
    <button type="button" class="h-zoom-close" aria-label={t('modulePages.ui.zoomClose')}><X size={20} aria-hidden="true" /></button>
  </dialog>
</Base>

<script>
  import { initZoom } from './zoom';
  initZoom();
</script>
