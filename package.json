{
  "name": "gr8r",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:worker": "bun run --cwd apps/worker dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "db:wipe": "bun run --cwd packages/db wipe",
    "db:reset": "bun run --cwd packages/db reset",
    "docs:check": "bun scripts/docs-check.ts",
    "docs:verify": "bun scripts/docs-verify.ts",
    "tenant": "bun packages/db/src/cli/tenant.ts"
  },
  "devDependencies": {
    "@gr8r/db": "workspace:*",
    "@gr8r/shared": "workspace:*",
    "@types/bun": "^1.4.3",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2"
  }
}
