# Переменные прод-развёртывания (docker-compose.prod.yml). Скопируйте в .env.prod (он в .gitignore) и заполните.
# Пароли и ключ: openssl rand -hex 32

# Домен, на который смотрит A-запись сервера. Caddy получит сертификат Let's Encrypt (нужны открытые 80 и 443).
# Для локальной проверки — localhost (самоподписанный сертификат Caddy).
DOMAIN=erp.example.com

# Суперпользователь postgres: миграции, CLI оператора, бэкапы
POSTGRES_PASSWORD=
# Логин-роль API и воркера (gr8r_app, без суперправ) и роль DDL воркера (gr8r_ddl)
APP_DB_PASSWORD=
DDL_DB_PASSWORD=

# Ключ шифрования секретов воркспейсов (AES-256-GCM, 64 hex). Храните отдельно от бэкапов:
# без него сохранённые секреты (ключи банков, ЮКассы) не прочитать, смена ключа делает их нечитаемыми.
SECRETS_KEY=

# Вебхук лидов оператора (необязательно): заявки арендаторов «Нужно больше?» дублируются POST-ом лидом.
# Полный адрес формы лидов: https://<домен>/api/hooks/leads/<токен> (Настройки → Формы лидов у арендатора оператора)
OPERATOR_LEAD_HOOK_URL=

# Сколько дней хранить ежедневные дампы в ./backups
BACKUP_KEEP_DAYS=14

# Свои серверы маршрутизации (задача 1213, docs/architecture/routing.md): запуск docker compose --profile routing
# ROUTING_OSRM_URL=http://osrm:5000
# ROUTING_VROOM_URL=http://vroom:3000
# ROUTING_NOMINATIM_URL=
