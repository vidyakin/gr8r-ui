# Скопируйте в .env (он в .gitignore). Все приложения монорепозитория читают корневой .env.

# --- База данных ---
# Админ-подключение: миграции, создание БД и ролей (суперпользователь или владелец БД).
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gr8r
# Рантайм-подключение API и воркера: логин-роль без суперправ, входит в app_user/app_worker.
# Роль создаёт `bun run db:migrate`, если заданы APP_DB_USER и APP_DB_PASSWORD.
DATABASE_URL=postgres://gr8r_app:gr8r_app@127.0.0.1:5432/gr8r
APP_DB_USER=gr8r_app
APP_DB_PASSWORD=gr8r_app
# DDL (индексы полей конструктора) выполняет только воркер, отдельной логин-ролью-владельцем (наследует app_owner, не суперпользователь).
# У API этого подключения нет и права `SET ROLE app_owner` тоже. Роль создаёт `bun run db:migrate`, если заданы DDL_DB_USER и DDL_DB_PASSWORD.
DATABASE_URL_DDL=postgres://gr8r_ddl:gr8r_ddl@127.0.0.1:5432/gr8r
DDL_DB_USER=gr8r_ddl
DDL_DB_PASSWORD=gr8r_ddl

# --- API ---
API_PORT=3000
# Источники, которым разрешены кросс-доменные запросы с cookie (через запятую). С прокси Vite не нужен.
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development
# Флаг Secure у cookie сессии: по умолчанию включён при NODE_ENV=production (нужен HTTPS)
# COOKIE_SECURE=0
# Доверять X-Forwarded-For (за nginx/балансировщиком) — для rate-limit по IP
# TRUST_PROXY=1
# Время жизни сессии, дней
SESSION_TTL_DAYS=30
# Rate-limit входа: попыток на окно (минут)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# --- Воркер ---
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4

# --- Хранилище файлов (MinIO, S3-совместимое) — используется со следующих этапов ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=gr8r
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
